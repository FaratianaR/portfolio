---
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/sora/600.css';
import '../styles/global.css';
import { navigation, email } from '../data/site';
interface Props { title?: string; description?: string; article?: boolean; }
const { title = 'Digital Projects & Web Operations', description = 'Faratiana Rahary : création web, SEO, e-commerce et opérations digitales. Des solutions concrètes, de la conception à l’amélioration continue.', article = false } = Astro.props;
const pathname = Astro.url.pathname;
const canonical = Astro.site ? new URL(pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Faratiana Rahary</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff5e8" />
    <meta property="og:title" content={`${title} — Faratiana Rahary`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="fr_FR" />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand header-brand" href="/" aria-label="Faratiana Rahary — Accueil"><img class="brand-logo" src="/images/faratiana-logo.png" alt="Faratiana Rahary" width="128" height="80" /><span class="brand-tagline">Digital Projects<br />&amp; Web Operations</span></a>
        <nav class="desktop-nav" aria-label="Navigation principale">
          {navigation.map(([href, label]) => <a href={href} aria-current={(href === '/' ? pathname === '/' : pathname.startsWith(href)) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <a class="button header-cta" href="/hire-me/">Parlons-en <span aria-hidden="true">↗</span></a>
        <details class="mobile-nav"><summary>Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Navigation mobile">{navigation.map(([href,label]) => <a href={href}>{label}</a>)}<a href="/hire-me/">Contact</a></nav></details>
      </div>
    </header>
    <main id="contenu"><slot /></main>
    <footer class="site-footer"><div class="container footer-grid">
      <div><a class="brand" href="/"><strong>Faratiana Rahary<span>.</span></strong></a><p>Digital Projects & Web Operations</p><p class="muted">Des idées claires.<br />Des solutions qui prennent vie.</p></div>
      <div><p class="eyebrow">Navigation</p><div class="footer-links">{navigation.map(([href,label]) => <a href={href}>{label}</a>)}</div></div>
      <div><p class="eyebrow">Restons en contact</p><a class="email-link" href={`mailto:${email}`}>{email} ↗</a><p><a href="/demande-cv-portfolio/">Demander le CV ou le portfolio</a></p><p class="muted">Projets en français et en anglais</p><a class="social-link" href="https://www.linkedin.com/in/faratiana-raharimanana-211a90188/" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.049c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>LinkedIn<span class="sr-only"> — nouvel onglet</span><span aria-hidden="true">↗</span></a></div>
    </div><div class="container copyright">© {new Date().getFullYear()} Faratiana Rahary <span>Conçu avec soin, construit avec Astro. <a href="https://github.com/FaratianaR/portfolio" target="_blank" rel="noopener noreferrer" style="text-decoration:underline;text-underline-offset:3px">Code source sur GitHub<span class="sr-only"> — nouvel onglet</span> ↗</a></span></div></footer>
  </body>
</html>
