---
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/sora/600.css';
import '../styles/global.css';
import { navigation, email } from '../data/site';
interface Props { title?: string; description?: string; article?: boolean; }
const { title = 'Digital Projects & Web Operations', description = 'Faratiana Rahary : création web, SEO, e-commerce et opérations digitales. Des solutions concrètes, de la conception à l’amélioration continue.', article = false } = Astro.props;
const pathname = Astro.url.pathname;
const canonical = Astro.site ? new URL(pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Faratiana Rahary</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff5e8" />
    <meta property="og:title" content={`${title} — Faratiana Rahary`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="fr_FR" />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand header-brand" href="/" aria-label="Faratiana Rahary — Accueil"><img class="brand-logo" src="/images/faratiana-logo.png" alt="Faratiana Rahary" width="128" height="80" /><span class="brand-tagline">Digital Projects<br />&amp; Web Operations</span></a>
        <nav class="desktop-nav" aria-label="Navigation principale">
          {navigation.map(([href, label]) => <a href={href} aria-current={(href === '/' ? pathname === '/' : pathname.startsWith(href)) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <a class="button header-cta" href="/hire-me/">Parlons-en <span aria-hidden="true">↗</span></a>
        <details class="mobile-nav"><summary>Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Navigation mobile">{navigation.map(([href,label]) => <a href={href}>{label}</a>)}<a href="/hire-me/">Contact</a></nav></details>
      </div>
    </header>
    <main id="contenu"><slot /></main>
    <footer class="site-footer"><div class="container footer-grid">
      <div><a class="brand" href="/"><strong>Faratiana Rahary<span>.</span></strong></a><p>Digital Projects & Web Operations</p><p class="muted">Des idées claires.<br />Des solutions qui prennent vie.</p></div>
      <div><p class="eyebrow">Navigation</p><div class="footer-links">{navigation.map(([href,label]) => <a href={href}>{label}</a>)}</div></div>
      <div><p class="eyebrow">Restons en contact</p><a class="email-link" href={`mailto:${email}`}>{email} ↗</a><p><a href="/demande-cv-portfolio/">Demander le CV ou le portfolio</a></p><p class="muted">Projets en français et en anglais</p><div class="footer-socials"><a class="social-link" href="https://www.linkedin.com/in/faratiana-raharimanana-211a90188/" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.049c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>LinkedIn<span class="sr-only"> — nouvel onglet</span><span aria-hidden="true">↗</span></a><a class="social-link" href="https://github.com/FaratianaR/portfolio" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.6-2.8 5.63-5.48 5.93.43.37.82 1.1.82 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"/></svg>GitHub<span class="sr-only"> — code source du site, nouvel onglet</span><span aria-hidden="true">↗</span></a></div></div>
    </div><div class="container copyright">© {new Date().getFullYear()} Faratiana Rahary <span>Conçu avec soin, construit avec Astro.</span></div></footer>
  </body>
</html>
