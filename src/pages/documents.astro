---
import Layout from '../layouts/Layout.astro';
import { email } from '../data/site';
---
<Layout title="CV et portfolio"><section class="page-hero"><div class="container"><p class="eyebrow">Mon parcours en détail</p><h1>CV & portfolio.</h1><p>Découvrez mes expériences, mes compétences et mon approche des projets digitaux.</p></div></section><section class="section"><div class="container split"><div><h2>Faisons le lien avec votre projet.</h2><p>Les documents sont disponibles sur demande. Indiquez-moi le contexte de votre projet pour que nous puissions échanger.</p><a class="button dark" href={`mailto:${email}?subject=${encodeURIComponent('Demande de CV et de portfolio')}`}>Demander le CV ou le portfolio ↗</a></div><div class="contact-panel"><p class="eyebrow">En attendant</p><h2>Découvrez mon univers</h2><p><a class="text-link" href="/about/">Mon parcours ↗</a></p><p><a class="text-link" href="/certifications/">Mes certifications ↗</a></p><a class="text-link" href="/prestations/">Mes prestations ↗</a></div></div></section></Layout>
