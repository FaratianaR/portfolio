---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import PostCard from '../components/PostCard.astro';
import { services, steps, stats, tools } from '../data/site';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Layout>
  <section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">Digital Project & Web Operations Specialist</p><h1>Je transforme vos besoins business en <span>solutions digitales concrètes.</span></h1><p class="hero-description">Sites web, applications, SEO, automatisation et opérations digitales : je vous accompagne de la conception au déploiement, puis dans l’optimisation quotidienne de vos outils et parcours.</p><p class="availability"><span aria-hidden="true">●</span> Disponible pour des projets en français et en anglais</p><div class="actions"><a class="button dark" href="/prestations/">Découvrir mes prestations <span aria-hidden="true">↗</span></a><a class="button outline" href="/hire-me/">Travaillons ensemble</a></div></div><div class="hero-portrait"><div class="portrait-halo"></div><img src="/images/faratiana.webp" alt="Faratiana Rahary, spécialiste projets digitaux et opérations web" width="900" height="1117" fetchpriority="high" /><div class="portrait-note"><span class="note-star" aria-hidden="true">✳</span><span>De la stratégie<br /><strong>à la réalisation.</strong></span></div></div></div><div class="hero-bottom container"><span>STRATÉGIE · CRÉATION · OPTIMISATION</span><a href="#profil">Découvrir mon univers ↓</a></div></section>
  <section id="profil" class="section"><div class="container split"><div><p class="eyebrow">Mon profil</p><h2>Technologie, stratégie<br />et expérience utilisateur.</h2></div><div><p class="lead">Mon parcours a évolué du marketing digital et du SEO vers un rôle transversal mêlant création web, applications, gestion de projets digitaux, opérations techniques et expérience client.</p><p>J’interviens sur l’ensemble du cycle d’un projet : compréhension du besoin, structuration de la solution, création, optimisation SEO et UX, intégrations, mise en ligne, suivi et amélioration continue.</p><a class="text-link" href="/about/">En savoir plus sur mon parcours ↗</a></div></div></section>
  <section class="section stats-section"><div class="container"><p class="eyebrow">Mon parcours en chiffres</p><h2>Expertise, résultats et leadership.</h2><div class="stats-grid">{stats.map(([value,title,description]) => <article><p class="stat-number">{value}</p><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
  <section class="section peach"><div class="container"><div class="section-heading"><div><p class="eyebrow">Mes prestations</p><h2>Concevoir, construire,<br />piloter et optimiser.</h2></div><a class="text-link" href="/prestations/">Toutes mes prestations ↗</a></div><div class="cards-grid">{services.map(([title,description],i) => <article class="service-card"><span class="card-number">0{i+1}</span><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
  <section class="section process"><div class="container"><p class="eyebrow">De l’idée au lancement</p><h2>Une continuité claire entre réflexion,<br />réalisation et amélioration.</h2><div class="process-grid">{steps.map(([title,description],i) => <article><span class="card-number">0{i+1}</span><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
  <section class="section"><div class="container"><p class="eyebrow">Tech & Tools</p><h2>Les bons outils pour le bon besoin.</h2><div class="tools-grid">{tools.map(([title,description]) => <article><h3>{title}</h3><p>{description}</p></article>)}</div><div class="ai-note"><span aria-hidden="true">✳</span><div><p class="eyebrow">AI-Enhanced Workflow</p><h2>L’IA comme accélérateur,<br />jamais comme pilote.</h2><p>Je l’utilise pour le prototypage, la recherche, la création d’applications, le SEO, l’automatisation, l’analyse et la documentation. L’analyse, les décisions et la compréhension du besoin restent au centre de mon approche.</p></div></div></div></section>
  <section class="section blog-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Le carnet digital</p><h2>Idées, méthodes & inspirations.</h2></div><a class="text-link" href="/blog/">Tous les articles ↗</a></div><div class="posts-grid">{posts.map(post => <PostCard post={post} />)}</div></div></section>
  <CTA />
</Layout>
