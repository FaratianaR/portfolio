---
import Layout from '../layouts/Layout.astro';
import CertificateCard from '../components/CertificateCard.astro';
import { certifications } from '../data/certifications';
const categories = [...new Set(certifications.map(c => c.category))];
---
<Layout title="Certifications">
  <section class="page-hero"><div class="container"><p class="eyebrow">Certifications</p><h1>Des compétences validées<br />et mises à jour.</h1></div></section>
  <section class="section"><div class="container" data-certifications>
    <div class="filters" aria-label="Filtrer les certifications">
      <button class="filter" data-cert-filter="all" aria-pressed="true">Toutes</button>
      {categories.map(category => <button class="filter" data-cert-filter={category} aria-pressed="false">{category}</button>)}
    </div>
    <p class="filter-status" aria-live="polite" data-cert-status>{Math.min(6, certifications.length)} sur {certifications.length} certifications affichées</p>
    <div class="cert-grid" id="certification-list">
      {certifications.map((certification, index) => <CertificateCard certification={certification} hidden={index >= 6} />)}
    </div>
    <div class="cert-controls">
      <button class="button dark" data-cert-more aria-controls="certification-list" hidden={certifications.length <= 6}>Lire la suite</button>
      <button class="filter" data-cert-less aria-controls="certification-list" hidden>Voir moins</button>
    </div>
    <noscript><style>.cert-card[hidden]{display:block!important}.cert-controls,.filters,[data-cert-status]{display:none!important}</style><p>Toutes les certifications sont affichées lorsque JavaScript est désactivé.</p></noscript>
  </div></section>
</Layout>
<script>import '../scripts/certifications';</script>
