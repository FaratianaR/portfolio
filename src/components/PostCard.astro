---
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const formattedDate = post.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<article class="post-card" data-category={post.data.category}>
  <div class="post-art" aria-hidden="true"><span>{post.data.category === 'SEO' ? '↗' : post.data.category === 'Web' ? '</>' : '✳'}</span><span class="art-label">Notes digitales / {post.data.category}</span></div>
  <div class="post-body"><div class="post-meta"><span>{post.data.category}</span><time datetime={post.data.date.toISOString()}>{formattedDate}</time></div><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="text-link" href={`/blog/${post.id}/`}>Lire l’article <span aria-hidden="true">↗</span><span class="sr-only"> : {post.data.title}</span></a></div>
</article>
